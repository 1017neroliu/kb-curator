# KB-Curator Environment Variables
# Copy this file to .env and adjust values
# Nested settings use __ delimiter (e.g. KB_CURATOR_GRAPH_STORE__URI)

# ---- Application ----
KB_CURATOR_DEBUG=false
KB_CURATOR_ENVIRONMENT=development

# ---- API ----
KB_CURATOR_API_HOST=0.0.0.0
KB_CURATOR_API_PORT=8000

# ---- LLM ----
KB_CURATOR_LLM__MODEL=gpt-4o-mini
KB_CURATOR_LLM__EMBEDDING_MODEL=text-embedding-3-small
KB_CURATOR_LLM__EMBEDDING_DIMENSIONS=1536

# ---- Vector Store ----
KB_CURATOR_VECTOR_STORE__TYPE=faiss
KB_CURATOR_VECTOR_STORE__FAISS_INDEX_PATH=./data/faiss_indexes

# ---- Neo4j ----
KB_CURATOR_GRAPH_STORE__URI=bolt://localhost:7687
KB_CURATOR_GRAPH_STORE__USER=neo4j
KB_CURATOR_GRAPH_STORE__PASSWORD=password

# ---- Redis ----
KB_CURATOR_REDIS__URL=redis://localhost:6379/0

# ---- Authentication ----
KB_CURATOR_AUTH__ENABLED=false
KB_CURATOR_AUTH__SECRET_KEY=change-me-in-production

# ---- Logging ----
KB_CURATOR_LOG_LEVEL=INFO
KB_CURATOR_LOG_FORMAT=json
